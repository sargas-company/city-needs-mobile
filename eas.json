{
    "cli": {
        "version": ">= 16.32.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_API_URL": "http://localhost:3001/api"
            }
        },
        "preview": {
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://api-cn.sargas.io/"
            }
        },
        "production": {
            "env": {
                "EXPO_PUBLIC_API_URL": "https://api-cn.sargas.io/"
            },
            "android": {
                "autoIncrement": true
            },
            "ios": {
                "autoIncrement": true
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleId": "vadim.dev27@gmail.com",
                "ascAppId": "6758922449",
                "appleTeamId": "UZ877F8655"
            }
        }
    }
}
